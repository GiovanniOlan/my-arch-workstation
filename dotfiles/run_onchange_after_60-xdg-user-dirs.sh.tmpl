#!/usr/bin/env bash
#
# Materialises the user directories declared in ~/.config/user-dirs.dirs. Runs
# after the files are written, and re-runs whenever that declaration changes,
# because the hash below is part of this script's rendered content.
#
# That declaration is a byte-for-byte copy of what xdg-user-dirs-update itself
# writes, plus the one entry it knows nothing about (XDG_SCREENSHOTS_DIR, which
# it preserves). That is not decoration: xdg-user-dirs.service is a user unit
# enabled by default, so the tool runs at every login no matter what this script
# does. Anything it would change -- its comment header, the PROJECTS entry from
# /etc/xdg/user-dirs.defaults, or the 0600 permissions -- has to be what chezmoi
# declares too, or the two rewrite the file against each other forever. The
# private_ prefix on the source file is what matches those permissions.
#
# user-dirs.dirs digest: {{ include (joinPath .chezmoi.sourceDir "dot_config" "private_user-dirs.dirs") | sha256sum }}
set -euo pipefail

{{ template "lib-log.bash" . }}

info "Creating user directories..."

dirs_file="$HOME/.config/user-dirs.dirs"

# Create every declared directory before xdg-user-dirs-update gets to look at
# them. It does not create the ones that are missing: it reports them as
# removed and rewrites the declaration to point at $HOME, which would undo the
# file chezmoi just wrote and leave the two fighting on every apply.
#
# Sourcing the file expands the $HOME in its values; re-reading it afterwards
# yields the variable names, so nothing here has to hardcode the list.
# shellcheck source=/dev/null
. "$dirs_file"
while IFS='=' read -r name _; do
    case "$name" in
        XDG_*_DIR) mkdir -p "${!name}" ;;
    esac
done <"$dirs_file"

xdg-user-dirs-update

ok "User directories ready."
