#!/usr/bin/env bash
#
# Materialises the user directories declared in ~/.config/user-dirs.dirs. Runs
# after the files are written, and re-runs whenever that declaration changes,
# because the hash below is part of this script's rendered content.

set -euo pipefail

{{ template "lib-log.bash" . }}

info "Creating user directories..."

dirs_file="$HOME/.config/user-dirs.dirs"

. "$dirs_file"
while IFS='=' read -r name _; do
    case "$name" in
        XDG_*_DIR) mkdir -p "${!name}" ;;
    esac
done <"$dirs_file"

xdg-user-dirs-update

ok "User directories ready."
