#!/usr/bin/env bash
#
# Installs Claude Code via Anthropic's native installer, which places a
# self-updating binary at ~/.local/bin/claude.
set -euo pipefail

{{ template "lib-log.bash" . }}

if [[ -x "$HOME/.local/bin/claude" ]]; then
    ok "Claude Code already installed."
    exit 0
fi

info "Installing Claude Code..."
curl -fsSL https://claude.ai/install.sh | bash

ok "Claude Code installed."
