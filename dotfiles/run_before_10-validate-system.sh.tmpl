#!/usr/bin/env bash

set -euo pipefail

{{ template "lib-log.bash" . }}

info "Validating the host system..."

[[ $EUID -eq 0 ]] && die "Run as your own user, not as root."

command -v pacman >/dev/null 2>&1 || die "This setup targets Arch Linux: pacman was not found."

command -v sudo >/dev/null 2>&1 || die "sudo is required to install packages and enable services."

ping -4 -c1 -W3 archlinux.org >/dev/null 2>&1 || die "No internet connection."

sudo -v || die "Could not elevate privileges."

ok "Host system validated ({{ .machine }})."
