# Theme derived from the shared palette. Fuzzel wants RRGGBBAA without a '#'.

[main]
font={{ .theme.fonts.ui }}:size={{ .theme.sizes.launcher }}
line-height=30
lines=8
width=30
horizontal-pad=20
vertical-pad=14
inner-pad=10

[colors]
background={{ .theme.colors.bg }}ee
text={{ .theme.colors.fg }}ff
prompt={{ .theme.colors.fg }}ff
input={{ .theme.colors.fg }}ff
match={{ .theme.colors.accent }}ff
selection={{ .theme.colors.accent }}ff
selection-text={{ .theme.colors.bg }}ff
selection-match={{ .theme.colors.bg }}ff
border={{ .theme.colors.accent }}ff

[border]
width=2
radius=10
